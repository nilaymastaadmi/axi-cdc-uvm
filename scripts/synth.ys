# Yosys synthesis for area figures.
#
# Generic cell library, so the numbers are technology-independent and comparable
# between modules rather than being a claim about any particular process.

read_verilog rtl/async_fifo.v
read_verilog rtl/axi4_slave.v
read_verilog rtl/cdc_bridge.v

hierarchy -check -top cdc_bridge
proc; opt; fsm; opt; memory; opt
techmap; opt

tee -o build/synth_cdc_bridge.txt stat

design -reset
read_verilog rtl/async_fifo.v
hierarchy -check -top async_fifo
proc; opt; fsm; opt; memory; opt; techmap; opt
tee -o build/synth_async_fifo.txt stat

design -reset
read_verilog rtl/axi4_slave.v
hierarchy -check -top axi4_slave
proc; opt; fsm; opt; memory; opt; techmap; opt
tee -o build/synth_axi4_slave.txt stat
